// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId     String     @id @default(uuid())
  email      String     @unique
  password   String?
  name       String
  role       Role
  phone              String?  @unique
  isVerified         Boolean  @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  attendee   Attendee?
  organizer  Organizer?
  admin      Admin?
  refreshToken       RefreshToken[]
}

model Attendee {
  userId             String   @id
  providerId         String?
  authProvider       AuthProvider
  isCompleted        Boolean   @default(false)
  languagePreference Language  @default(EN)
  birthDate          DateTime?
  gender             Gender?
  city               City?
  categories         AttendeeFavoriteCategory[]

  user               User     @relation(fields: [userId], references: [userId])
}

model Organizer {
  userId       String   @id // primary key inherited
  city         City
  organization String

  user         User     @relation(fields: [userId], references: [userId])
}

model Admin {
  userId          String   @id // primary key inherited
  secondPassword  String
  secondEmail     String

  user            User     @relation(fields: [userId], references: [userId])
}

model Category {
  id        String                     @id @default(uuid())
  name      CategoryName               @unique
  attendees AttendeeFavoriteCategory[]
}

model AttendeeFavoriteCategory {
  attendee   Attendee  @relation(fields: [attendeeId], references: [userId])
  attendeeId String
  category   Category  @relation(fields: [categoryId], references: [id])
  categoryId String
  @@id([attendeeId, categoryId])
}

enum Role {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum CategoryName {
  MUSIC
  SPORTS
  THEATER
  COMEDY
  EDUCATION
  TECHNOLOGY
  HEALTH
  BUSINESS
  ART
  TRAVEL
}

enum Gender {
  MALE
  FEMALE
}

enum City {
  CAIRO
  ALEXANDRIA
  GIZA
  LUXOR
  ASWAN
  SHARM_EL_SHEIKH
  HURGHADA
  TANTA
  MANSOURA
  PORT_SAID
  SUEZ
  ISMAILIA
  ZAGAZIG
  DAMIETTA
  FAYOUM
  BENI_SUEF
  QENA
}

enum AuthProvider {
  GOOGLE
  FACEBOOK
  APPLE
  LOCAL
}

enum Language {
  EN
  AR
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  code      String
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model ResetPasswordToken {
  id         Int      @id @default(autoincrement())
  email      String
  token      String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
}

model RefreshToken {
  id        Int       @id   @default(autoincrement())
  token     String    @unique
  isRevoked Boolean   @default(false)
  createdAt DateTime  @default(now())
  expiresAt DateTime

  userId    String
  user      User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  @@unique([userId, token])
}