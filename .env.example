# ========================
# APP Settings (Local Dev Defaults)
# ========================
APP_NAME=Fa3liat
JWT_KEY=change-me-dev-jwt-secret
JWT_REKEY=change-me-dev-jwt-refresh-secret
NODE_ENV=development
HOSTNAME=127.0.0.1
PUBLIC_HOST=localhost
BIND_HOST=0.0.0.0
PROTOCOL=http
PORT=3000
APP_URL=http://127.0.0.1:3000
STORAGE_TYPE=local
APP_CURRENCY=USD
SMS_PROVIDER=mock

# ========================
# Database Settings
# ========================
DATABASE_URL=postgresql://fa3liat:fa3liat@localhost:5434/fa3liat?schema=public

# Optional (leave blank to use the DATABASE_URL database name)
DATABASE_NAME=

# ========================
# Mail Settings
# ========================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM="no-reply@example.com"

# ========================
# Newsletter Settings
# ========================
NEWSLETTER_CONFIRMATION_SUCCESS_URL=/newsletter/success
NEWSLETTER_CONFIRMATION_ALREADY_SUBSCRIBED_URL=/newsletter/already-subscribed
NEWSLETTER_CONFIRMATION_FAILURE_URL=/newsletter/failure
NEWSLETTER_JWT_KEY=change-me-dev-newsletter-secret
NEWSLETTER_JWT_EXPIRY=1h

# ========================
# Redis Settings
# ========================
REDIS_URL=redis://127.0.0.1:6381

# ========================
# Frontend Settings
# ========================
FRONT_URL=http://localhost:5173

# ========================
# Google Maps API Key
# ========================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ========================
# Google OAuth Settings
# ========================
CLIENT_ID=your_google_oauth_client_id
CLIENT_SECRET=your_google_oauth_client_secret
CALLBACK_URL=/api/v1/auth/google/callback
GOOGLE_REDIRECT_URL=http://localhost:5173/auth/google/callback

# ========================
# Stripe Settings
# ========================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
SUCCESS_ROUTE=/ar/payment/success
CANCEL_ROUTE=/ar/payment/cancel

# ========================
# OpenAI Settings
# ========================
AI_API_KEY=your_ai_api_key_here

# ========================
# AI & Vector Search Settings
# ========================
OLLAMA_BASE_URL=http://127.0.0.1:11436
OLLAMA_MODEL=nomic-embed-text-v2-moe:latest
OLLAMA_TIMEOUT=30000
OLLAMA_DIMENSION=768
